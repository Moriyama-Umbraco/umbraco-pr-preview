{
  "manifestVersion": 1,
  "id": "umbraco-pr-preview",
  "name": "Umbraco PR Preview",
  "version": "0.1.3",
  "publisher": "Moriyama",
  "public": false,
  "description": "Renders changed uSync and Umbraco Deploy data types and document types in a pull request tab, using the real Umbraco backoffice editors, side by side with the target branch.",
  "categories": ["Azure Repos"],
  "tags": ["Umbraco", "uSync", "Umbraco Deploy", "pull request", "code review"],
  "galleryFlags": ["Preview"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "icons": { "default": "images/icon.png" },
  "content": { "details": { "path": "overview.md" } },
  "scopes": ["vso.code"],
  "files": [
    { "path": "dist", "addressable": true },
    { "path": "images", "addressable": true }
  ],
  "contributions": [
    {
      "id": "umbraco-pr-tab",
      "type": "ms.vss-web.tab",
      "description": "Umbraco schema preview for pull requests",
      "targets": ["ms.vss-code-web.pr-tabs"],
      "properties": {
        "name": "Umbraco",
        "title": "Umbraco",
        "uri": "dist/pr-tab.html"
      }
    }
  ]
}
